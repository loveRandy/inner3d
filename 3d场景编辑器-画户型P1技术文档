// 使用 SVG viewBox 或 Canvas transform 的逆矩阵
function screenToWorld(sx: number, sy: number, view: ViewState): Vec2;
```

### 7.2 正交吸附

```typescript
function applyOrtho(start: Vec2, end: Vec2): Vec2 {
  const dx = end.x - start.x;
  const dz = end.z - start.z;
  if (Math.abs(dx) >= Math.abs(dz)) return { x: end.x, z: start.z };
  return { x: start.x, z: end.z };
}
```

