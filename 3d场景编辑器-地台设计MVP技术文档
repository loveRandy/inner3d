## 13. 附录

### 13.1 进入 / 退出伪代码

```typescript
function enterPlatformDesignMode(roomId: string) {
  const room = document.floorPlan?.rooms[roomId];
  if (!room) return;
  const presetId = room.floorMaterial?.presetId ?? DEFAULT_FLOOR_PRESET_ID;
  set({
    platformDesignMode: {
      active: true,
      roomId,
      snapshotPresetId: presetId,
      draftPresetId: presetId,
      activePresetId: null,
      canvasView: fitViewToRoom(roomId),
    },
  });
  usePlatformHistoryStore.getState().clear();
}

function exitPlatformDesignMode({ save = false } = {}) {
  const mode = get().platformDesignMode;
  if (!mode) return;
  if (save) {
    useSceneStore.getState().updateRoomFloorMaterial(mode.roomId, {
      presetId: mode.draftPresetId,
    });
  }
  set({ platformDesignMode: null, selectedRoomId: null });
}
```

