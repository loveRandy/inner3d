# 复制为 .env.deploy.local 后填写（该文件已被 git 忽略，勿提交密钥）

# 七牛账号密钥（控制台 → 密钥管理）
QINIU_ACCESS_KEY=your_access_key
QINIU_SECRET_KEY=your_secret_key

# 存储空间名称
QINIU_BUCKET=randy

# 上传到 bucket 内的目录前缀，末尾保留 /
QINIU_PREFIX=3d-scene-editor/

# 存储区域：z0 华东 | z1 华北 | z2 华南 | na0 北美 | as0 东南亚
# bucket 报错 "please use up-z2.qiniup.com" 时改为 z2
QINIU_ZONE=z2

# 七牛绑定的 CDN 访问域名 + 与 QINIU_PREFIX 一致的路径，末尾必须带 /
# 示例：https://cdn.example.com/3d-scene-editor/
# 或测试域名：https://xxxx.bkt.clouddn.com/3d-scene-editor/
VITE_CDN_BASE_URL=https://your-cdn-domain.com/3d-scene-editor/
